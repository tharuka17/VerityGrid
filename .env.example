# VerityGrid — example environment file.
# Copy to .env for local use. Never commit .env or real credentials.
# Every value below is optional: the defaults shown here are what the code uses.

APP_NAME=VerityGrid
ENVIRONMENT=development
DEBUG=true

# --- Access mode (backend) ---
# demo (the default when unset or invalid): the API is READ-ONLY. Every POST, PUT, PATCH and DELETE is
#   rejected with HTTP 403 (code read_only_mode). Use this for any deployment that other people can reach.
# development: uploads, scans and reviews are OPEN to anyone who can reach the server. Local work only.
# This is not authentication: it has no users, tokens or roles. Restart the API after changing it.
VERITYGRID_MODE=demo

# --- Backend ---
DATABASE_URL=sqlite:///./veritygrid.db
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_ROWS=50000
MAX_UPLOAD_COLUMNS=200

# --- AI classification ---
# "mock" (default): offline rule-based placeholder. No key and no network.
# "gemini": a real model through the Google Gemini API. Needs the key and model below.
AI_PROVIDER=mock
# Create a key in Google AI Studio and paste it into your local .env only.
GEMINI_API_KEY=
# Copy a current model ID from https://ai.google.dev/gemini-api/docs/models (no default is built in).
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_ATTEMPTS=2

# --- Dashboard (Streamlit) ---
# The dashboard reads only variables that start with VERITYGRID_, so the backend secrets above
# are never loaded into it. It contacts the API at this address from the Streamlit server.
VERITYGRID_API_URL=http://127.0.0.1:8000
VERITYGRID_CONNECT_TIMEOUT_SECONDS=3
VERITYGRID_READ_TIMEOUT_SECONDS=30