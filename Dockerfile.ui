# Render deploys this service automatically when a push changes a file in its render.yaml buildFilter.

# VerityGrid dashboard (Streamlit). A pure HTTP client: it needs only the ui/ package and the API's address.
# Build:  docker build -f Dockerfile.ui -t veritygrid-ui .
# It contains no secrets and no backend code.
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

RUN useradd --create-home --uid 10001 verity
WORKDIR /app
RUN chown verity:verity /app

COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY --chown=verity:verity ui ./ui

# Where the Streamlit server (not the browser) finds the API. Compose overrides nothing here; a platform sets it.
ENV VERITYGRID_API_URL=http://api:8000

USER verity

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('PORT', '8501') + '/_stcore/health', timeout=3)"

CMD ["sh", "-c", "exec streamlit run ui/streamlit_app.py --server.address=0.0.0.0 --server.port=${PORT:-8501} --server.headless=true --browser.gatherUsageStats=false"]